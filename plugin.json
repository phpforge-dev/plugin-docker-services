{
  "id": "phpforge.docker-services",
  "name": "Docker Services",
  "version": "1.0.1",
  "minIdeVersion": "0.2.13",
  "main": "main.js",
  "description": "docker-services workbench integration with explicit host services.",
  "activation": {
    "languages": []
  },
  "permissions": [
    "project.read",
    "workbench",
    "process"
  ],
  "workbench": {
    "apiVersion": 1,
    "main": "workbench.js",
    "style": "workbench.css",
    "services": [
      "dockerCancel",
      "dockerCompose",
      "dockerComposeFiles",
      "dockerContainerAction",
      "dockerContexts",
      "dockerLogs",
      "dockerPull",
      "dockerSnapshot",
      "onDockerProgress"
    ]
  }
}
